# Copy this file to .env, then add valid keys. Never commit .env.
# Gemini is used for chat and Mem0. Cohere is used for document embeddings and reranking.
GEMINI_API_KEY=
COHERE_API_KEY=

# Cohere uses embed-english-v3.0 and a separate local Qdrant collection.
EMBEDDING_PROVIDER=cohere
COHERE_EMBEDDING_MODEL=embed-english-v3.0
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_MEMORY_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Optional. Leave empty to use the persistent local Qdrant index in ./data/qdrant.
# Example for a Qdrant server: http://localhost:6333
QDRANT_URL=
